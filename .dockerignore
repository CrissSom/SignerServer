# Secrets — must never reach the build context.
# Depth-independent: the real .env lives in docker_portainer/, not at the root,
# and a bare `.env` pattern would not match it.
**/.env
**/.env.*
**/*.pem
**/*.pfx
**/*.p12

# VCS / CI
.git
.gitignore
.github

# Docs and host-only deployment helpers
README.md
LICENSE
scripts/

# Deployment files. The Dockerfile lives in docker_portainer/ but the build
# context is the repo root, so these are excluded by their real paths. The
# entrypoint is re-included: the Dockerfile COPYs it into the image.
docker_portainer/*
!docker_portainer/docker-entrypoint.sh

# Python build noise. Depth-independent: app/__pycache__ from a developer's
# machine would otherwise be baked into the image by `COPY app/`.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/dist/
**/build/

# Test artefacts
**/*.exe
**/*.dll
**/*.msi
