# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Docker Compose reads this file automatically.
#
# In Portainer there is no .env file: paste these same names and values into
# the stack's "Environment variables" panel instead.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED — the stack refuses to deploy without these
# ═════════════════════════════════════════════════════════════════════════════

# Full URL of your Azure Key Vault
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# Name of the code-signing certificate in that vault (RSA or EC)
CERTIFICATE_NAME=your-code-signing-cert


# ═════════════════════════════════════════════════════════════════════════════
# Azure authentication
# ═════════════════════════════════════════════════════════════════════════════
# Option A — Service principal (client credentials).
#   Use this on any non-Azure host, which includes most Portainer boxes.
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-value

# Option B — Managed identity (Azure VM / Container Instances / AKS).
#   Leave all three of the above empty and the server falls back to the
#   host's managed identity automatically.


# ═════════════════════════════════════════════════════════════════════════════
# API security
# ═════════════════════════════════════════════════════════════════════════════
# Clients must then send:  X-API-Key: <value>
# Leave empty to disable authentication entirely (not recommended).
# Generate one with:  openssl rand -hex 32
API_KEY=change-me-to-a-strong-random-secret


# ═════════════════════════════════════════════════════════════════════════════
# Signing defaults (optional)
# ═════════════════════════════════════════════════════════════════════════════
# RFC-3161 timestamp server applied to every signature
DEFAULT_TIMESTAMP_URL=http://timestamp.digicert.com

# Digest algorithm: SHA-256 | SHA-384 | SHA-512
DEFAULT_DIGEST=SHA-256

# Maximum upload size in bytes (default 200 MB)
MAX_UPLOAD_BYTES=209715200


# ═════════════════════════════════════════════════════════════════════════════
# Container / stack settings (optional)
# ═════════════════════════════════════════════════════════════════════════════
# Image to run. Point IMAGE_TAG at a release tag to pin a version.
IMAGE_NAME=ghcr.io/crisssom/signerserver
IMAGE_TAG=latest

# Name of the running container.
# Careful: Portainer's own container is named `portainer` in its documented
# install, and Docker will not allow two containers with the same name. If this
# host also runs Portainer, change this or the stack will fail to deploy.
CONTAINER_NAME=portainer

# Host port published to clients
HOST_PORT=8080

# Interface the port binds to. Use 127.0.0.1 when a reverse proxy on the same
# host terminates TLS, so the plain-HTTP port is not reachable from the LAN.
BIND_ADDRESS=0.0.0.0

# Container memory ceiling. Raise it if you sign very large binaries.
MEMORY_LIMIT=1g

# Uvicorn worker processes. 1 is right unless you sign many files concurrently.
WEB_CONCURRENCY=1

# Log verbosity: critical | error | warning | info | debug | trace
LOG_LEVEL=info
