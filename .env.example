# ─────────────────────────────────────────────────────────────────────────────
# Azure Key Vault (required)
# ─────────────────────────────────────────────────────────────────────────────

# Full URL of your Azure Key Vault
KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/

# Name of the certificate stored in Key Vault (must be an RSA or EC cert)
CERTIFICATE_NAME=your-code-signing-cert

# ─────────────────────────────────────────────────────────────────────────────
# Azure authentication
# ─────────────────────────────────────────────────────────────────────────────
# Option A — Service principal (client credentials)
#   Recommended for on-premises or non-Azure Linux hosts.
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-value

# Option B — Managed Identity (Azure VMs / Container Instances / AKS)
#   Leave TENANT_ID / CLIENT_ID / CLIENT_SECRET blank and the server will
#   automatically use the VM/container's managed identity.

# ─────────────────────────────────────────────────────────────────────────────
# API security
# ─────────────────────────────────────────────────────────────────────────────
# Set a strong random key to protect the signing endpoint.
# Clients must pass:  X-API-Key: <value>
# Leave blank to disable authentication (not recommended for production).
API_KEY=change-me-to-a-strong-random-secret

# ─────────────────────────────────────────────────────────────────────────────
# Signing defaults (optional)
# ─────────────────────────────────────────────────────────────────────────────
# RFC-3161 timestamp server used to timestamp every signature
DEFAULT_TIMESTAMP_URL=http://timestamp.digicert.com

# Digest algorithm for the timestamp token: sha256 | sha384 | sha512
DEFAULT_TIMESTAMP_DIGEST=sha256

# Maximum upload size in bytes (default 200 MB)
MAX_UPLOAD_BYTES=209715200

# Path to AzureSignTool binary if it is not on PATH
# AZURE_SIGN_TOOL_PATH=/opt/dotnet-tools/AzureSignTool
